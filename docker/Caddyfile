koysor.duckdns.org {
	encode zstd gzip

	@root path /
	redir @root /quant/ permanent

	handle /options/* {
		reverse_proxy options:8501
	}

	handle /fixed-income/* {
		reverse_proxy fixed-income:8501
	}

	handle /portfolio/* {
		reverse_proxy portfolio-management:8501
	}

	handle /maths/* {
		reverse_proxy host.docker.internal:8505
	}

	redir /flashcards /flashcards/ permanent

	# Flash cards are pre-rendered by the quant-finance-flash-cards deploy into
	# ~/flashcards-site/releases/<sha>, with "current" a symlink to the live one
	# (mounted read-only, see docker-compose.prod.yml).  /a/b is the file
	# a/b.html; the index, graph and other large pages have .zst/.gz copies.
	handle_path /flashcards/* {
		root * /srv/flashcards-site/current
		@pages not path /static/*
		header @pages Cache-Control "public, max-age=300"
		header /static/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html
		file_server {
			precompressed zstd gzip
		}
	}

	# Unknown flash card URLs get the site's own 404 page, which also finds a
	# card from a bare /flashcards/card/<slug> link.
	handle_errors 404 {
		@flashcards path /flashcards/*
		handle @flashcards {
			root * /srv/flashcards-site/current
			rewrite * /404.html
			file_server
		}
	}

	handle {
		reverse_proxy quant-finance:8501
	}
}
