koysor.duckdns.org {
	encode zstd gzip

	@root path /
	redir @root /quant/ permanent

	handle /options/* {
		reverse_proxy options:8501
	}

	handle /fixed-income/* {
		reverse_proxy fixed-income:8501
	}

	handle /portfolio/* {
		reverse_proxy portfolio-management:8501
	}

	handle /maths/* {
		reverse_proxy host.docker.internal:8505
	}

	redir /flashcards /flashcards/ permanent

	handle_path /flashcards/* {
		reverse_proxy host.docker.internal:8506 {
			header_up X-Forwarded-Prefix /flashcards
		}
	}

	handle {
		reverse_proxy quant-finance:8501
	}
}
